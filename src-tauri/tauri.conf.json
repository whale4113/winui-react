{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinUI React Gallery",
  "version": "0.1.0",
  "identifier": "dev.winui.react.gallery",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "WinUI React Gallery", "width": 1440, "height": 1000, "minWidth": 640, "minHeight": 480, "decorations": false, "transparent": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
